# --- Lakekeeper (Iceberg REST catalog) bare origin — never includes /catalog ---
LAKEKEEPER_URL=http://localhost:8181
LAKEKEEPER_WAREHOUSE=lakehouse

# --- OAuth2 client-credentials (Keycloak realm homelab) ---
# scope is ALWAYS "lakekeeper" explicitly — the shared client default is
# "catalog", which Lakekeeper rejects (services/lakekeeper/AGENTS.md).
LAKEKEEPER_SERVICE_CLIENT_ID=lakekeeper-service
LAKEKEEPER_SERVICE_CLIENT_SECRET=
LAKEKEEPER_OAUTH_SCOPE=lakekeeper

# --- Token endpoint (first non-empty wins) ---
LAKEKEEPER_OAUTH_TOKEN_URL=  # full token URL override; takes precedence
LAKEKEEPER_KEYCLOAK_URL=http://localhost:8080  # used to derive the token URL
LAKEKEEPER_KEYCLOAK_REALM=homelab

# --- TLS verification (True/False or CA bundle path) ---
LAKEKEEPER_TLS_PROFILE=
LAKEKEEPER_TLS_PROFILE_REF=

# --- Tool Toggle Switches (set False to disable) ---
LAKEKEEPERTOOL=True
INGESTTOOL=True
